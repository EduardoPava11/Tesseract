cabal-version:      3.0
name:               tesseract-isp
version:            0.1.0.0
synopsis:           Physics-grounded ISP spec: DNG RAW -> 4D (R,G,B,T) GIF
description:
  Pure-Haskell mathematical specification of the Tesseract iPhone app's ISP
  pipeline. Every stage is grounded in sensor physics (Bayer wavelengths,
  Poisson photon statistics, Heisenberg bounds) and carries propagated
  uncertainty from DNG photosite to GIF palette index. Library + reference
  executable + QuickCheck laws + golden JSON vectors.
license:            MIT
author:             Eduardo Pava
maintainer:         maxypava@gmail.com
build-type:         Simple

common warnings
  ghc-options:      -Wall -Wunused-packages -Wincomplete-uni-patterns

common deps
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    DeriveFunctor
    DeriveGeneric
    GADTs
    KindSignatures
    LambdaCase
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
  build-depends:
      base          >= 4.18  && < 5
    , bytestring    >= 0.11  && < 0.13
    , binary        >= 0.8   && < 0.9
    , vector        >= 0.13  && < 0.14

library
  import:           warnings, deps
  hs-source-dirs:   src
  exposed-modules:
    ISP.Sensor.Uncertainty
    ISP.Sensor.Physics
    ISP.Sensor.Noise
    ISP.Sensor.Anscombe
    ISP.Bayer
    ISP.Time
    ISP.DNG
    ISP.Pyramid
    ISP.Tesseract
    ISP.Palette
    ISP.GIF
    ISP.Pipeline
    ISP.Oklab
    ISP.Bayer.Dither
    ISP.ColorDouble
    ISP.ColorDouble.KMeans
    ISP.ColorDouble.PCA
    ISP.ColorDouble.Coproduct
    ISP.Fingerprint
    ISP.PaletteSpine
    ISP.Compose
    ISP.BinomialBeauty
    ISP.FingerprintHistogram
    ISP.BinomialEMD
    ISP.BirkhoffBinomial
    ISP.MapElitesBinomial
    ISP.Laws.Physics
    ISP.Laws.Noise
    ISP.Laws.Uncertainty
    ISP.Laws.Bayer
    ISP.Laws.Tesseract
    ISP.Laws.Pyramid
    ISP.Laws.Palette
    ISP.Laws.Pipeline
    ISP.Laws.Oklab
    ISP.Laws.BayerDither
    ISP.Laws.ColorDouble
    ISP.Laws.Fingerprint
    ISP.Laws.PaletteSpine
    ISP.Laws.BinomialBeauty
  build-depends:
      JuicyPixels   >= 3.3   && < 3.4
    , QuickCheck    >= 2.14  && < 2.16

executable tesseract-isp-run
  import:           warnings, deps
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      tesseract-isp
    , optparse-applicative >= 0.17 && < 0.19

executable tesseract-isp-mkfixture
  import:           warnings, deps
  hs-source-dirs:   fixtures
  main-is:          Gen.hs
  build-depends:
      tesseract-isp
    , directory            >= 1.3  && < 1.4

executable tesseract-isp-golden
  import:           warnings, deps
  hs-source-dirs:   golden
  main-is:          Main.hs
  build-depends:
      tesseract-isp
    , aeson                >= 2.1  && < 2.3
    , aeson-pretty         >= 0.8  && < 0.9
    , directory            >= 1.3  && < 1.4
    , filepath             >= 1.4  && < 1.5

test-suite spec
  import:           warnings, deps
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:
      tesseract-isp
    , QuickCheck    >= 2.14  && < 2.16
