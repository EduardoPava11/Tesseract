# NN lab build artifacts
nn/metal-harness/build/
# Corpora are PROGRAMS (data.py + seed regenerates byte-identically);
# emitted corpora never enter the repo. (nn/debayer/*.npz stays TRACKED
# by design — weights + golden vectors are the parity chain.)
nn/dither/*.npz

nn/phase/*.npz

# SK gene corpus: emitted by spec/output/SKCorpusEmit.hs (make corpus),
# byte-identical on regeneration — corpora are programs, never repo data.
nn/sk-gene/corpus/
nn/descent/corpus/
nn/descent/DescentAssign.mlpackage/
nn/jepa/corpus/
# Edit-space corpus: emitted by spec/output/EditCorpusEmit.hs
# (make corpus-edit). 262144 rows = 64^3, about 35 MB.
nn/edit-options/corpus/
nn/jepa/JepaH.mlpackage/
